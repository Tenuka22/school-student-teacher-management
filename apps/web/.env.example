# apps/web/.env.example — copy to apps/web/.env and fill in:
#   cp apps/web/.env.example apps/web/.env
#
# `.env` is gitignored and this file is the committed template. Every key below
# is declared in `apps/web/.env.schema` (Varlock) and nothing else is read from
# this file; `packages/db/.env.schema` adds no keys of its own — it imports
# NODE_ENV and DATABASE_URL from here.
#
# `bun install` / `bun run postinstall` runs `varlock codegen`, which fails
# fast on a missing or malformed value, so a typo here stops the boot with a
# message naming the key rather than surfacing later as a null session.

# Runtime mode. @public. One of: development | production | test.
# The container image sets this itself; leave it as `development` locally.
NODE_ENV=development

# Secret key for signing sessions and tokens. At least 32 characters.
# Generate one: `openssl rand -base64 32`. Left blank on purpose: never commit
# a real value. Rotating it invalidates every session.
BETTER_AUTH_SECRET=

# Public origin this app is served from, e.g. http://localhost:3001.
# Used as the trusted origin for auth callbacks and links in emails.
# Under Docker Compose this is overridden to http://localhost:3001.
BETTER_AUTH_URL=http://localhost:3001

# PostgreSQL connection string. @type=string(minLength=1).
# Locally (docker compose postgres, port 3000):
#   postgresql://postgres:password@localhost:3000/school-student-teacher-management
# In the container the host is the `postgres` service — docker-compose.yml
# overrides this value, so leave it as the localhost form in `.env`.
DATABASE_URL=postgresql://postgres:password@localhost:3000/school-student-teacher-management

# --- Seeded accounts -------------------------------------------------------
# These sign in with fixed usernames \u2014 `admin`, `principal`, `inventory-admin`,
# `academic-admin` and `leave-admin`
# (constants in packages/auth/src/admin.ts, not configurable here). The account
# is created on server start if it does not exist; an existing password is
# NEVER overwritten, so a password changed in /account survives a restart.
# Left blank on purpose. The server REFUSES TO START if any of these is unset,
# shorter than 12 characters, or equal to a value ever committed to this
# repository (packages/auth/src/seat-password-policy.ts): an earlier version of
# this file carried example passwords and a deployment kept one (forensic audit
# F-03). Generate each with `openssl rand -base64 18`. The value is the INITIAL
# password only; to rotate an existing seat, change it here and run
# `bun --env-file=apps/web/.env scripts/rotate-seat-password.ts <username>`.
# These accounts have no staff record, so they cannot hold
# equipment.
#
# There is no seeded Deputy Principal account. A Deputy (or Assistant)
# Principal is a real staff member holding a current-year `staffPosition`
# (role `vicePrincipal`), assigned manually from the Teachers register by the
# Administrator, the Principal, or the Academic Administrator \u2014 and any
# number of staff may hold it at once.

# Password for the `admin` account (the non-leadership administrator).
ADMIN_PASSWORD=

# Display name for the `admin` account. Falls back to "Admin" if empty.
ADMIN_NAME=Admin

# Password for the `principal` account (the Principal; role `principal`).
PRINCIPAL_PASSWORD=

# Display name for the `principal` account. Falls back to "Principal" if empty.
PRINCIPAL_NAME=Principal

# Password for the `inventory-admin` account (role `inventoryAdmin`). This is
# the seat that assigns, transfers and marks equipment returned \u2014 teachers
# can only view their own equipment, never change custody themselves.
INVENTORY_ADMIN_PASSWORD=

# Display name for the `inventory-admin` account. Falls back to
# "Inventory Administrator" if empty.
INVENTORY_ADMIN_NAME=Inventory Administrator

# Password for the `academic-admin` account (role `academicAdmin`). The
# academic desk: teacher register, classes, periods, attendance, academic
# years, teacher requests and accounts, in its own `/academic-admin` workspace.
ACADEMIC_ADMIN_PASSWORD=

# Display name for the `academic-admin` account. Falls back to
# "Academic Administrator" if empty.
ACADEMIC_ADMIN_NAME=Academic Administrator

# Password for the `leave-admin` account (role `leaveAdmin`). Reviews the
# school-wide leave queue and sets leave-type entitlements/quotas, in its
# own `/leave-admin` workspace.
LEAVE_ADMIN_PASSWORD=

# Display name for the `leave-admin` account. Falls back to
# "Leave Administrator" if empty.
LEAVE_ADMIN_NAME=Leave Administrator

# --- Object storage (MinIO) -------------------------------------------------
# Where uploaded files live — today just inventory item photos. Addressed
# through the S3 API, so the same client works against MinIO or real S3.
# Locally this points at the MinIO container already in docker-compose.yml
# (console on :9001, API on :9000) with its default root credentials.

# API host, no scheme. @public.
MINIO_ENDPOINT=localhost

# API port. @public.
MINIO_PORT=9000

# false locally (plain HTTP on localhost); true once MinIO sits behind a
# TLS-terminating proxy. @public.
MINIO_USE_SSL=false

# Bucket credentials. Blank on purpose. The local dev container in
# docker-compose.yml defaults to minioadmin / minioadmin; use real values for
# any shared or production deployment.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Bucket every uploaded file is written to. Created once, ahead of time —
# this app never calls `CreateBucket`. @public.
MINIO_BUCKET=aloysius

# --- Outbound mail (authentication codes) ----------------------------------
# Sign-in codes, email verification, password reset and teacher
# self-registration all send email. Leave MAIL_TRANSPORT empty locally: codes
# are printed to the server console. In PRODUCTION an empty value makes every
# send fail (deliberately — see packages/auth/src/email.ts); set
# MAIL_TRANSPORT=resend with a Resend API key and a verified sender.
MAIL_TRANSPORT=
MAIL_FROM=
RESEND_API_KEY=
