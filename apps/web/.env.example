# apps/web/.env.example — copy to apps/web/.env and fill in:
#   cp apps/web/.env.example apps/web/.env
#
# `.env` is gitignored and this file is the committed template. Every key below
# is declared in `apps/web/.env.schema` (Varlock) and nothing else is read from
# this file; `packages/db/.env.schema` adds no keys of its own — it imports
# NODE_ENV and DATABASE_URL from here.
#
# `bun install` / `bun run postinstall` runs `varlock codegen`, which fails
# fast on a missing or malformed value, so a typo here stops the boot with a
# message naming the key rather than surfacing later as a null session.

# Runtime mode. @public. One of: development | production | test.
# The container image sets this itself; leave it as `development` locally.
NODE_ENV=development

# Secret key for signing sessions and tokens. At least 32 characters.
# Generate one: `openssl rand -base64 32`. Never commit a real value, and never
# reuse this example's placeholder — rotating it invalidates every session.
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# Public origin this app is served from, e.g. http://localhost:3001.
# Used as the trusted origin for auth callbacks and links in emails.
# Under Docker Compose this is overridden to http://localhost:3001.
BETTER_AUTH_URL=http://localhost:3001

# PostgreSQL connection string. @type=string(minLength=1).
# Locally (docker compose postgres, port 3000):
#   postgresql://postgres:password@localhost:3000/school-student-teacher-management
# In the container the host is the `postgres` service — docker-compose.yml
# overrides this value, so leave it as the localhost form in `.env`.
DATABASE_URL=postgresql://postgres:password@localhost:3000/school-student-teacher-management

# --- Seeded accounts -------------------------------------------------------
# These sign in with fixed usernames — `admin`, `principal`, `deputy-principal`
# (constants in packages/auth/src/admin.ts, not configurable here). The account
# is created on server start if it does not exist; an existing password is
# NEVER overwritten, so a password changed in /account survives a restart.
# Minimum 8 characters. To reset one on purpose, see README "Environment
# Configuration". These accounts have no staff record, so they cannot hold
# equipment.

# Password for the `admin` account (the non-leadership administrator).
ADMIN_PASSWORD=change-me-admin

# Display name for the `admin` account. Falls back to "Admin" if empty.
ADMIN_NAME=Admin

# Password for the `principal` account (the Principal; role `principal`).
PRINCIPAL_PASSWORD=change-me-principal

# Display name for the `principal` account. Falls back to "Principal" if empty.
PRINCIPAL_NAME=Principal

# Password for the `deputy-principal` account (role `vicePrincipal`).
DEPUTY_PRINCIPAL_PASSWORD=change-me-deputy-principal

# Display name for the `deputy-principal` account. Falls back to
# "Deputy Principal" if empty.
DEPUTY_PRINCIPAL_NAME=Deputy Principal
