# @sensitive={preventLeaks=false} @type=string(minLength=10)
PRINCIPAL_NIC=

# @sensitive={preventLeaks=false} @type=string(minLength=8)
PRINCIPAL_PASSWORD=

# @sensitive={preventLeaks=false} @type=string(minLength=1)
PRINCIPAL_NAME=

# Deputy Principal's NIC — doubles as their login username.
# @sensitive={preventLeaks=false} @type=string(minLength=10)
DEPUTY_PRINCIPAL_NIC=

# @sensitive={preventLeaks=false} @type=string(minLength=8)
DEPUTY_PRINCIPAL_PASSWORD=

# @sensitive={preventLeaks=false} @type=string(minLength=1)
DEPUTY_PRINCIPAL_NAME=

# Shared code required to use the leadership sign-up page (Deputy Principal / Principal).
# @sensitive={preventLeaks=false} @type=string(minLength=8)
LEADERSHIP_SETUP_CODE=
