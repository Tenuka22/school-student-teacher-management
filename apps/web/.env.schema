# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# The seeded accounts sign in with fixed usernames — `admin`, `principal` and
# `deputy-principal` (see packages/auth/src/admin.ts). They are pure admin
# accounts: no NIC, no staff record. Only passwords and display names are
# configurable.

# These are submitted as plaintext by the sign-in form on every login, so
# they legitimately transit request/response bodies — exempt them from the
# leak scanner (still masked in logs, just not stream-scanned).
# @sensitive={preventLeaks=false} @type=string(minLength=8)
PRINCIPAL_PASSWORD=

# @public @type=string(minLength=1)
PRINCIPAL_NAME=

# @sensitive={preventLeaks=false} @type=string(minLength=8)
DEPUTY_PRINCIPAL_PASSWORD=

# @public @type=string(minLength=1)
DEPUTY_PRINCIPAL_NAME=

# @sensitive={preventLeaks=false} @type=string(minLength=8)
ADMIN_PASSWORD=

# @public @type=string(minLength=1)
ADMIN_NAME=
