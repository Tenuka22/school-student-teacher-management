# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The app's own public address — the same value rendered on every page as
# the canonical URL, the Open Graph `og:url`/`og:image` origin, the
# `EducationalOrganization` JSON-LD `url`, and every `<loc>` in
# /sitemap.xml (see src/functions/get-site-origin.ts). It legitimately
# transits every response body; exempt it from the leak scanner like the
# seeded passwords below, for the opposite reason — this one is meant to be
# public, not merely unavoidable.
# @sensitive={preventLeaks=false} @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# The seeded accounts sign in with fixed usernames \u2014 `admin`, `principal`,
# `inventory-admin`, `academic-admin` and `leave-admin` (see
# packages/auth/src/admin.ts). They are pure admin accounts: no NIC, no staff
# record. Only passwords and display names are configurable. There is no
# seeded Deputy Principal account \u2014 a Deputy (or Assistant) Principal is a
# real staff member holding a current-year `staffPosition`, assigned manually
# by the Administrator, the Principal, or the Academic Administrator.

# These are submitted as plaintext by the sign-in form on every login, so
# they legitimately transit request/response bodies \u2014 exempt them from the
# leak scanner (still masked in logs, just not stream-scanned).
# @sensitive={preventLeaks=false} @type=string(minLength=12)
PRINCIPAL_PASSWORD=

# @public @type=string(minLength=1)
PRINCIPAL_NAME=

# @sensitive={preventLeaks=false} @type=string(minLength=12)
ADMIN_PASSWORD=

# @public @type=string(minLength=1)
ADMIN_NAME=

# @sensitive={preventLeaks=false} @type=string(minLength=12)
INVENTORY_ADMIN_PASSWORD=

# @public @type=string(minLength=1)
INVENTORY_ADMIN_NAME=

# @sensitive={preventLeaks=false} @type=string(minLength=12)
ACADEMIC_ADMIN_PASSWORD=

# @public @type=string(minLength=1)
ACADEMIC_ADMIN_NAME=

# @sensitive={preventLeaks=false} @type=string(minLength=12)
LEAVE_ADMIN_PASSWORD=

# @public @type=string(minLength=1)
LEAVE_ADMIN_NAME=

# Outbound mail for authentication codes (packages/auth/src/email.ts). Unset
# means the console transport in development and test, and **every send
# fails** in production — sign-in OTPs, email verification, password reset and
# teacher self-registration all need a real transport there.
# @public @optional @type=enum(console, resend)
MAIL_TRANSPORT=

# Sender, e.g. "St. Aloysius College <no-reply@example.lk>". Required by resend.
# @public @optional @type=string(minLength=3)
MAIL_FROM=

# @optional @type=string(minLength=1)
RESEND_API_KEY=
